# ===========================
# Custom ZSH Configuration
# ===========================
# This file should be sourced from your main .zshrc
# Add this line to the end of your .zshrc:
#   source ~/dotfiles/zsh/.zshrc.custom

# Preferred editor for local and remote sessions
export EDITOR='nvim'
export VISUAL='nvim'
export PATH="$HOME/.local/bin:$PATH"

# ===========================
# Herdr + Tmux + Neovim Configuration
# ===========================

# Herdr aliases
alias h='herdr'
alias ha='herdr session attach'
alias hl='herdr session list'
alias hu='herdr update'

# Tmux aliases
alias t='tmux'
alias ta='tmux attach -t'
alias tn='tmux new -s'
alias tl='tmux ls'
alias tk='tmux kill-session -t'
alias td='tmux detach'

# Start the selected multiplexer on SSH login.
# DOTFILES_SSH_MULTIPLEXER accepts: herdr (default), tmux, none.
if [[ -n "$SSH_CONNECTION" ]] && [[ -z "$HERDR_ENV" ]] && [[ -z "$TMUX" ]]; then
  case "${DOTFILES_SSH_MULTIPLEXER:-herdr}" in
    herdr)
      herdr
      ;;
    tmux)
      if command -v tmux >/dev/null 2>&1; then
        tmux attach -t "${TMUX_AUTO_SESSION:-0}" || tmux new -s "${TMUX_AUTO_SESSION:-0}"
      fi
      ;;
    none)
      ;;
  esac
fi

# Neovim aliases
alias vim='nvim'
alias vi='nvim'

# Prevent typing a directory name from implicitly changing directories.
# This ensures mistyped/missing commands don't unexpectedly `cd` into folders.
unsetopt AUTO_CD

# TUI tool aliases
alias lg='lazygit'
alias y='yazi'

# AI Coding Assistant aliases
alias cop='copilot'

_sync_codex_shared_skills() {
  local sync_script="$HOME/dotfiles/codex/sync-skills.sh"
  if [[ -x "$sync_script" ]]; then
    "$sync_script" --quiet 2>/dev/null
  fi
}

codex() {
  _sync_codex_shared_skills
  command codex "$@"
}

cx() {
  codex "$@"
}

# Better navigation with neovim inside tmux
export TERM=xterm-256color

# ===========================
# Go (Golang) Configuration
# ===========================

# Go configuration
export GOPATH="$HOME/go-workspace"
# Add Linux Go binary path; on macOS Homebrew manages this automatically
if [[ "$(uname)" != "Darwin" ]] && [[ -d "/usr/local/go/bin" ]]; then
  export PATH="/usr/local/go/bin:$PATH"
fi
export PATH="$GOPATH/bin:$PATH"

# ===========================
# Node Version Manager (fnm)
# ===========================

# zoxide (smart cd)
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi

# fnm (Fast Node Manager)
FNM_PATH="$HOME/.local/share/fnm"
if [ -d "$FNM_PATH" ]; then
  export PATH="$FNM_PATH:$PATH"
  eval "$(fnm env --use-on-cd --shell zsh)"
  # Keep user-local npm binaries (for example Codex) ahead of fnm-managed globals.
  export PATH="$HOME/.local/bin:$PATH"
fi

# ===========================
# Beads Command Repo
# ===========================

# Route bd at the private external command repo so issue state never lands in
# a source checkout. The path comes from explicit bootstrap, which writes
# machine-local state that is deliberately untracked. Anything unusable is
# ignored silently: a machine that never bootstrapped still gets a working
# shell, and execution workflows report the missing route themselves.
# BEADS-ROUTING-START
: "${BEADS_COMMAND_CONFIG_PATH:=$HOME/.config/beads-command/env}"
if [ -r "$BEADS_COMMAND_CONFIG_PATH" ]; then
  __beads_dir="$(sed -n 's/^BEADS_DIR=//p' "$BEADS_COMMAND_CONFIG_PATH" 2>/dev/null | tail -n1)"
  case "$__beads_dir" in
    /*) [ -d "$__beads_dir" ] && export BEADS_DIR="$__beads_dir" ;;
  esac
  unset __beads_dir
fi
# BEADS-ROUTING-END
